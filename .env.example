# Copiez ce fichier en `.env` et remplissez les valeurs (voir README.md).
# Ne committez jamais `.env` ni de clé secrète dans git.

# --- Supabase (clients) ---
# URL de votre projet : https://<project-id>.supabase.co
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Supabase (côté serveur uniquement) ---
# Clé secrète du projet (dashboard → Settings → API → preferred secret key).
# À définir dans les secrets du déploiement, jamais committée.
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Notifications (optionnelles sans clé) ---
RESEND_API_KEY="re_..."
RESEND_FROM="Allô Techno <noreply@exemple.com>"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Préfixe international par défaut pour les numéros de téléphone (sans "+")
PHONE_COUNTRY_PREFIX="229"

# --- Divers (côté serveur) ---
TRACKING_CODE_PEPPER=""

# --- Paiement en ligne (Flutterwave, optionnel) ---
# Sans ces clés, le paiement en ligne est désactivé (les commandes boutique
# passent en « paiement à la remise »). Configurer la clé secrète comme secret
# du déploiement et renseigner FLUTTERWAVE_WEBHOOK_SECRET_HASH correspondant à
# l'entête `verif-hash` défini dans le dashboard Flutterwave.
# URL du webhook à enregistrer chez Flutterwave : https://allotechno.africa/api/flutterwave-webhook
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

# --- Paiement mobile money (FedaPay / KKiaPay, optionnel) ---
# FedaPay : clé secrète API (dashboard FedaPay) + secret de l'endpoint webhook
# (Workbench → Webhooks) ; mettre FEDAPAY_SANDBOX sur "false" en production.
# URL du webhook : https://allotechno.africa/api/fedapay-webhook
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""
FEDAPAY_SANDBOX="true"
# KKiaPay : clés API (dashboard KKiaPay → Développeurs) ; le secret hash du
# webhook est celui saisi dans le tableau de bord (entête x-kkiapay-secret).
# URL du webhook : https://allotechno.africa/api/kkiapay-webhook
KKIAPAY_API_KEY=""
KKIAPAY_SECRET=""
KKIAPAY_WEBHOOK_SECRET=""
KKIAPAY_SANDBOX="true"

# --- Rappels automatiques (cron GitHub Actions) ---
# Jeton Bearer requis par /api/cron-reminders (secret du dépôt CRON_TOKEN).
CRON_TOKEN=""