# Copiez ce fichier en `.env` et remplissez les valeurs (voir README.md).
# Ne committez jamais `.env` ni de clé secrète dans git.

# --- Supabase (clients) ---
# URL de votre projet : https://<project-id>.supabase.co
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Supabase (côté serveur uniquement) ---
# Clé secrète du projet (dashboard → Settings → API → preferred secret key).
# À définir dans les secrets du déploiement, jamais committée.
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Notifications (optionnelles sans clé) ---
RESEND_API_KEY="re_..."
RESEND_FROM="Allô Techno <noreply@exemple.com>"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Préfixe international par défaut pour les numéros de téléphone (sans "+")
PHONE_COUNTRY_PREFIX="229"

# --- Divers (côté serveur) ---
TRACKING_CODE_PEPPER=""