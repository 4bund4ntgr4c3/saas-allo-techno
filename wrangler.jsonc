{
  // Configuration Cloudflare Workers — fusionnée par nitro dans .output/server/wrangler.json au build.
  // NE PAS mettre de secrets ici (service role, pepper, Resend, WhatsApp) : utiliser `wrangler secret put`.
  "name": "saas-allo-techno",
  // Variables non secrètes, accessibles via process.env côté serveur
  "vars": {
    "SUPABASE_URL": "https://fcxmecphvflmbqayyioj.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_7qJ94OD6U7esKSJIsFLOCg_wLjJyQzO",
  },
  // Domaine de production — à activer après avoir ajouté la zone allotechno.africa
  // dans le dashboard Cloudflare (Add a site) + configuré les DNS.
  // "routes": [
  //   { "pattern": "allotechno.africa", "custom_domain": true },
  //   { "pattern": "www.allotechno.africa", "custom_domain": true }
  // ]
  //
  // Rate limiting persistant via Cloudflare KV.
  // 1. Créer le namespace : wrangler kv:namespace create RATE_LIMIT
  // 2. Remplacer VOTRE_NAMESPACE_ID par l'ID obtenu :
  // "kv_namespaces": [
  //   { "binding": "RATE_LIMIT_KV", "id": "VOTRE_NAMESPACE_ID" }
  // ]
  // Le code src/lib/security.ts utilisera KV automatiquement si le binding existe.
  //
  // Notifications Web Push (RFC 8291/8292) — obligatoire pour /api/push-send :
  // npx web-push generate-vapid-keys --json  →  puis :
  // wrangler secret put VAPID_PUBLIC_KEY
  // wrangler secret put VAPID_PRIVATE_KEY
  // La clé publique VAPID doit aussi être exposée au client en var non secrète
  // VITE_VAPID_PUBLIC_KEY (src/lib/push-notifications.ts) pour l'abonnement.
  //
  // Notifications transactionnelles via WhatsApp Cloud API (Meta) — GRATUIT pour
  // les messages de service (OTP, avancement dossier, devis, retrait) depuis
  // nov. 2024 ; sans configuration, les notifications sont simulées (log).
  // Prérequis :
  // 1. Compte Meta Business + numéro WhatsApp vérifié (Business Manager)
  // 2. Templates approuvés en français : dossier_enregistre, devis_prest,
  //    appareil_prest, rappel_garantie (voir src/lib/whatsapp-cloud.ts)
  // 3. Secrets :
  //    wrangler secret put WHATSAPP_ACCESS_TOKEN      (System User token)
  //    wrangler secret put WHATSAPP_PHONE_NUMBER_ID   (numéro WhatsApp Business)
}
